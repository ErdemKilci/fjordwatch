@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudText Typo="Typo.h6" Class="ml-2">FjordWatch</MudText>
        <MudSpacer />
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Map">Map</MudButton>
        <MudButton Href="/anomalies" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Warning">Anomalies</MudButton>
        <ConnectionStatus />
        <MudIconButton Icon="@Icons.Material.Filled.Help" Color="Color.Default" Href="/about" />
    </MudAppBar>
    <MudMainContent Class="pa-0">
        @Body
    </MudMainContent>
</MudLayout>
