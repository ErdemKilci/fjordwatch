# ============================================================================
# FjordWatch environment configuration
# Copy to `.env` (which is gitignored) and adjust per machine.
# Never commit a populated `.env`.
# ============================================================================

# ---- Postgres (PostGIS + pgvector) ------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fjordwatch
POSTGRES_USER=fjordwatch
POSTGRES_PASSWORD=fjordwatch_dev_only_change_me

# Connection string used by services that take a single DSN.
DATABASE_URL=postgres://fjordwatch:fjordwatch_dev_only_change_me@postgres:5432/fjordwatch

# ---- Redis (Streams + cache) ------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
AIS_STREAM=ais:positions

# ---- MinIO / S3-compatible object storage ----------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fjordwatch
MINIO_ROOT_PASSWORD=fjordwatch_dev_only_change_me
S3_ENDPOINT=http://minio:9000
S3_BUCKET_SAR=sar-tiles
S3_BUCKET_FIXTURES=fixtures

# ---- AIS ingestion (Rust service) ------------------------------------------
# Live source. Set AIS_REPLAY_FILE to use a recorded fixture instead. Inside
# the container, /fixtures maps to services/ais-ingestion/tests/fixtures.
# Example: AIS_REPLAY_FILE=/fixtures/sample.nmea
AIS_SOURCE_HOST=153.44.253.27
AIS_SOURCE_PORT=5631
AIS_REPLAY_FILE=
AIS_REPLAY_DELAY_MS=0
AIS_BATCH_SIZE=200
AIS_RECONNECT_INITIAL_BACKOFF_MS=500
AIS_RECONNECT_MAX_BACKOFF_MS=30000
AIS_METRICS_PORT=9100

# ---- Core API (.NET) -------------------------------------------------------
CORE_API_PORT=8080
CORE_API_API_KEY=dev-replace-me
ASPNETCORE_ENVIRONMENT=Development

# ---- LLM provider selection -------------------------------------------------
# Set to `ollama` (default, local) or `azure_openai`.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Only required when LLM_PROVIDER=azure_openai.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ---- ML services ------------------------------------------------------------
SHIP_DETECTION_PORT=8001
ANOMALY_DETECTION_PORT=8002
SAR_FETCHER_PORT=8003

# Copernicus Data Space Ecosystem credentials (free registration). Optional;
# the SAR fetcher falls back to fixture data when these are blank.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ---- Observability (optional, see docker-compose.observability.yml) ---------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAMESPACE=fjordwatch

# ---- Web frontend ----------------------------------------------------------
WEB_PORT=5050
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_HUB_URL=http://localhost:8080/hubs/vessels

# Comma-separated origins allowed to call /vessels, /anomalies, /sar,
# /agent/chat, and /hubs/vessels. Must include the URL the user opens in
# the browser. Default tracks WEB_PORT.
CORS_ORIGINS=http://localhost:5050
